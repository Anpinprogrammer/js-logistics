rules_version = '2';
// Quién puede leer y escribir cada parte de la base de datos.
// Solo entra quien tiene un documento en "usuarios" (lo crea el administrador desde la app).
// Roles: admin (todo), asistente (pedidos, clientes y saldos), mensajero (solo sus pedidos,
//        su caja y su sueldo), cliente (solo lee sus pedidos, pruebas de entrega y saldo).
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() { return request.auth != null; }
    function ruta(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    function esMiembro() { return autenticado() && exists(ruta("usuarios", request.auth.uid)); }
    function esAdmin() { return autenticado() && exists(ruta("admins", request.auth.uid)); }
    function esAsistente() { return esMiembro() && get(ruta("usuarios", request.auth.uid)).data.rol == "asistente"; }
    function esOficina() { return esAdmin() || esAsistente(); }
    // Cliente: cuenta de solo lectura asociada a un cliente (usuarios/{uid}.clienteId)
    function esCliente() { return esMiembro() && get(ruta("usuarios", request.auth.uid)).data.rol == "cliente"; }
    function esClienteDe(cid) { return esCliente() && cid == get(ruta("usuarios", request.auth.uid)).data.clienteId; }
    function pedidoDeMiCliente(guia) { return esCliente() && exists(ruta("pedidos", guia)) && esClienteDe(get(ruta("pedidos", guia)).data.clienteId); }
    // Equipo de trabajo: cualquier cuenta que no sea de cliente
    function esEquipo() { return esMiembro() && get(ruta("usuarios", request.auth.uid)).data.rol != "cliente"; }
    // Nombre en Personal vinculado a la cuenta que hace la petición
    function tengoVinculo() { return autenticado() && exists(ruta("vinculos", request.auth.uid)); }
    function esMio(mid) { return tengoVinculo() && mid == get(ruta("vinculos", request.auth.uid)).data.mensajeroId; }
    function pedidoMio(guia) { return exists(ruta("pedidos", guia)) && esMio(get(ruta("pedidos", guia)).data.mensajeroId); }

    // Configuración inicial: solo si todavía no existe meta/config, y en la misma escritura que la crea.
    function primerAdmin(uid) {
      return autenticado() && request.auth.uid == uid
        && !exists(ruta("meta", "config"))
        && existsAfter(ruta("meta", "config"));
    }
    match /meta/config {
      allow read: if autenticado();
      allow create: if autenticado()
        && request.resource.data.primerAdmin == request.auth.uid
        && existsAfter(ruta("admins", request.auth.uid));
    }
    // Contador de guías: solo sube de uno en uno (administración puede corregirlo)
    match /meta/{id} {
      allow read: if esEquipo();
      allow create: if esAdmin() || (esEquipo() && id == "contador"
        && request.resource.data.keys().hasOnly(["n"]) && request.resource.data.n == 1);
      allow update: if esAdmin() || (esEquipo() && id == "contador"
        && request.resource.data.keys().hasOnly(["n"]) && request.resource.data.n == resource.data.n + 1);
    }

    // Cuentas, roles y vínculos: cada quien ve lo suyo; solo administración los cambia
    match /admins/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow create: if primerAdmin(uid) || esAdmin();
      allow delete: if esAdmin() && uid != request.auth.uid;
    }
    match /usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow create: if primerAdmin(uid) || esAdmin();
      allow update: if esAdmin() && (uid != request.auth.uid || request.resource.data.rol == resource.data.rol);
      allow delete: if esAdmin() && uid != request.auth.uid;
    }
    match /vinculos/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || resource.data.uid == request.auth.uid || esAdmin());
      allow write: if esAdmin();
    }

    // Pedidos: oficina ve y organiza todos; cada mensajero solo los suyos. Borrar: solo administración.
    // El mensajero crea la guía en cero (los valores los pone la oficina) y después solo cambia
    // los datos de la entrega, incluido el valor cobrado.
    function pedidoNuevoDeMensajero(guia) {
      let d = request.resource.data;
      return esMio(d.mensajeroId) && d.guia == guia && d.estado == "pendiente"
        && d.clienteId == "" && d.valorServicio == 0 && d.aCobrar == 0
        && d.keys().hasOnly(["guia", "n", "estado", "creado", "mensajeroId", "mini", "clienteId", "valorServicio", "aCobrar", "por"]);
    }
    function entregaDeMensajero() {
      return esMio(resource.data.mensajeroId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "estado", "entregado", "destinatario", "valorCobrado", "metodo", "cuentaJs", "difCobro",
          "entregoUid", "intentos", "motivoDev", "notaDev", "cobrarDev", "cambio", "gasto", "gastoNota"]);
    }
    // El cliente solo puede confirmar que recibió la prenda de un cambio de sus pedidos
    function confirmaCambioCliente() {
      return esClienteDe(resource.data.clienteId) && resource.data.get("cambio", false) == true
        && resource.data.get("cambioRecibido", 0) == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["cambioRecibido", "cambioConfirmo"])
        && request.resource.data.cambioConfirmo == request.auth.uid
        && request.resource.data.cambioRecibido is int;
    }
    match /pedidos/{guia} {
      // Leer una guía que no existe solo dice que está libre (lo usa la creación de guías)
      allow read: if esOficina() || (esEquipo() && resource == null) || esMio(resource.data.mensajeroId)
        || esClienteDe(resource.data.clienteId);
      allow create: if esOficina() || pedidoNuevoDeMensajero(guia);
      allow update: if esOficina() || entregaDeMensajero() || confirmaCambioCliente();
      allow delete: if esAdmin();
    }
    // Fotos de salida y de entrega (el documento se llama como la guía)
    match /fotos/{guia} {
      allow read: if esOficina() || pedidoMio(guia) || pedidoDeMiCliente(guia);
      allow update: if esOficina() || pedidoMio(guia);
      allow create: if esEquipo();
      allow delete: if esAdmin();
    }
    match /entregas/{guia} {
      allow read: if esOficina() || pedidoMio(guia) || pedidoDeMiCliente(guia);
      allow update: if esOficina() || pedidoMio(guia);
      allow create: if esOficina() || pedidoMio(guia);
      allow delete: if esAdmin();
    }

    // Clientes: oficina los ve y registra; borrar solo administración
    match /clientes/{id} {
      allow read: if esOficina() || esClienteDe(resource.data.id);
      allow create, update: if esOficina();
      allow delete: if esAdmin();
    }
    // Pagos y ajustes de clientes: oficina los ve (saldos); solo administración los registra
    match /movimientos/{id} {
      allow read: if esOficina() || esClienteDe(resource.data.clienteId);
      // El asistente solo registra compras por encargo y ganancias ocasionales; no borra ni edita
      allow create: if esAdmin() || (esAsistente() && request.resource.data.tipo in ["compra_cliente", "ganancia"]
        && request.resource.data.valor is number && request.resource.data.valor > 0);
      allow update, delete: if esAdmin();
    }
    // Personal: oficina ve la lista; cada mensajero solo su propia ficha
    match /mensajeros/{id} {
      allow read: if esOficina() || esMio(resource.data.id);
      allow write: if esAdmin();
    }
    // Dinero entregado y liquidaciones: cada quien lo suyo
    match /recaudos/{id} {
      allow read: if esAdmin() || esMio(resource.data.mensajeroId);
      allow write: if esAdmin();
    }
    match /liquidaciones/{id} {
      allow read: if esAdmin() || esMio(resource.data.mensajeroId);
      allow write: if esAdmin();
    }
    // Caja general: cada quien solo sus adelantos y pagos de sueldo
    match /cajamovs/{id} {
      allow read: if esAdmin() || esMio(resource.data.personaId) || (esAsistente() && resource.data.cat == "interna");
      // El asistente registra entradas y salidas de las cuentas internas (JS Envíos, MT, base); no borra ni edita
      allow create: if esAdmin() || (esAsistente() && request.resource.data.cat == "interna"
        && request.resource.data.tipo in ["entra", "sale"] && request.resource.data.valor is number
        && request.resource.data.valor > 0 && exists(ruta("cuentas", request.resource.data.cuentaId)));
      allow update, delete: if esAdmin();
    }
    // Cuentas internas (JS Envíos, MT, Base de JS): oficina las ve; solo administración las crea
    match /cuentas/{id} {
      allow read: if esOficina();
      allow write: if esAdmin();
    }
    // Solo administración
    // Días de pago fijo (patinadores, oficina, JS): cada quien ve los suyos
    match /jornadas/{id} {
      allow read: if esAdmin() || esMio(resource.data.personaId);
      allow write: if esAdmin();
    }
    match /papelera/{id} { allow read, write: if esAdmin(); }
    match /papelera_fotos/{id} { allow read, write: if esAdmin(); }

    // Historial: un documento por día y por persona ("AAAA-MM-DD_<uid>"); cada quien escribe el suyo
    match /historial/{id} {
      allow read: if esAdmin() || (autenticado() && id.matches("^[0-9-]+_" + request.auth.uid + "$"));
      allow create, update: if esEquipo() && (esAdmin() || id.matches("^[0-9-]+_" + request.auth.uid + "$"));
      allow delete: if esAdmin();
    }
  }
}
