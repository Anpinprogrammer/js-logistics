# Copia este archivo como .env y llena los valores. El .env nunca se sube al repositorio.

# development | test | production
NODE_ENV=development
PORT=4000

# Cadena de conexión de Postgres. En Supabase: botón Connect → Connection String.
# Para la app (Render y local) usa el Transaction pooler, puerto 6543:
#   postgresql://postgres.<ref>:<clave>@aws-0-<región>.pooler.supabase.com:6543/postgres
# El Session pooler (5432) tiene 15 cupos para todo el proyecto y se agota con varios computadores.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/js_logistics
# (Opcional) Para npm run db:migrar, db:importar y db:demo. En Supabase, el Session pooler, puerto 5432:
#   postgresql://postgres.<ref>:<clave>@aws-0-<región>.pooler.supabase.com:5432/postgres
# Vacío = usan DATABASE_URL.
DATABASE_URL_MIGRACIONES=
# true en Supabase (exige TLS); false en un Postgres local
DATABASE_SSL=false

# Secreto para firmar los JWT: mínimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión (formato de jsonwebtoken: 8h, 12h, 7d…)
JWT_EXPIRA=12h

# Orígenes del frontend que pueden llamar a la API con cookies, separados por coma, con https:// y sin barra final.
# Producción: https://jslogistics.pro,https://www.jslogistics.pro,https://app.jslogistics.pro
CORS_ORIGENES=http://localhost:5173

# Nombre de la cookie que lleva el JWT
COOKIE_NOMBRE=jsl_sesion
# Dominio de la cookie (vacío = el del backend). Con subdominios propios: .midominio.com
COOKIE_DOMINIO=
# lax (recomendado: frontend y API en el mismo sitio) | strict | none (dominios distintos; Safari en iOS la puede bloquear)
COOKIE_SAMESITE=lax

# (Opcional) Certificado PEM de la base para verificar TLS. Pega el contenido en una línea con \n.
DATABASE_CA=

# Conexiones del pool POR PROCESO (no por usuario: todos los usuarios comparten este pool).
# 5 en Render y 3 en cada computador de desarrollo. Súbelo solo con el Transaction pooler (6543).
DATABASE_POOL_MAX=5
# Cerrar conexiones inactivas pronto libera cupo del pooler.
DATABASE_POOL_IDLE_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Supabase Storage (fotos y firmas). Project Settings → API. La service role key es SECRETA: solo en el backend.
# Crea el bucket como PRIVADO; el frontend recibe URL firmadas que vencen en 1 hora.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=pedidos

# Correo transaccional con Resend (https://resend.com). Crea la API key en Dashboard → API Keys.
# Sin RESEND_API_KEY la API funciona, pero no envía correos: en desarrollo el enlace sale en la consola.
# El dominio de CORREO_REMITENTE debe estar verificado en Resend (Domains).
# Para desarrollo sin dominio verificado: CORREO_REMITENTE=onboarding@resend.dev
# (Resend solo permite enviar desde ahí al correo de la cuenta con la que te registraste).
RESEND_API_KEY=
CORREO_REMITENTE=no-responder@jslogistics.pro
CORREO_NOMBRE=JS Logistics
# Logo que se muestra en el correo: URL absoluta y pública. Usa PNG (Outlook no muestra WebP).
CORREO_LOGO_URL=https://app.jslogistics.pro/logo.png
# A dónde responder si alguien contesta el correo (opcional).
CORREO_RESPUESTA=

# Enlaces de los correos: cada portal tiene sus pantallas /activar y /restablecer.
# En producción: https://jslogistics.pro y https://app.jslogistics.pro
URL_CLIENTES=http://localhost:3000
URL_EQUIPO=http://localhost:5173
# Vigencia: 60 minutos para cambiar la contraseña y 7 días para activar una cuenta.
ENLACE_CLAVE_MINUTOS=60
# Código de 6 dígitos para recuperar la contraseña
CODIGO_MINUTOS=10
CODIGO_INTENTOS=5
CODIGO_ENVIOS_HORA=3
ENLACE_ACTIVACION_DIAS=7

# Proxies delante del backend (para la IP real en el límite de intentos).
# 1 = solo Render (los frontends llaman directo a la API con VITE_API_URL). 2 = si hay otro proxy delante,
# por ejemplo Cloudflare con la nube naranja en api.jslogistics.pro.
TRUST_PROXY=1

# ---------- Chatbot de clientes (Claude) ----------
# Llave de la API de Anthropic: https://console.anthropic.com → API Keys. Es SECRETA: solo en el backend.
# Sin ella, POST /api/chatbot/mensajes responde 503 CHATBOT_NO_CONFIGURADO y el cliente va a WhatsApp.
ANTHROPIC_API_KEY=
# Modelo. Por defecto Haiku 5.5 (rápido y barato). Para cambiarlo basta poner otro ID, por ejemplo claude-sonnet-5-5.
CHATBOT_MODELO=claude-haiku-5-5
# Qué tanto razona el modelo: low (por defecto) | medium | high
CHATBOT_ESFUERZO=low
CHATBOT_MAX_TOKENS=1024
# Horarios, proceso de envío y políticas (markdown que edita administración). Ruta desde backend/.
CHATBOT_INFO_ARCHIVO=chatbot/informacion-empresa.md
# WhatsApp de atención humana: solo dígitos con indicativo (573001234567). Vacío = sin enlace de WhatsApp.
CHATBOT_WHATSAPP=
# Límites por cliente (por cuenta): mensajes por minuto y por día.
CHATBOT_LIMITE_MINUTO=8
CHATBOT_LIMITE_DIA=100

# Chat PÚBLICO (visitantes sin sesión): solo info general y estado de un envío, sin nombres ni dinero.
# Límites por IP y un tope global por día (protege el presupuesto de Anthropic). Pon false para apagarlo.
CHATBOT_PUBLICO_ACTIVO=true
CHATBOT_PUBLICO_MINUTO=5
CHATBOT_PUBLICO_DIA=30
CHATBOT_PUBLICO_DIA_TOTAL=500

# Rastreo PÚBLICO de una guía (sin sesión): solo pasos y fechas. Límites por IP (por minuto y por día) y tope global por día.
RASTREO_POR_MINUTO=20
RASTREO_POR_DIA=300
RASTREO_DIA_TOTAL=20000

# Formulario público "Solicitar envío" de la landing (sin sesión). false lo apaga.
# Límites por IP (por hora y por día), tope global por día y tope de solicitudes sin revisar.
SOLICITUDES_ACTIVO=true
SOLICITUDES_POR_HORA=5
SOLICITUDES_POR_DIA=15
SOLICITUDES_DIA_TOTAL=300
SOLICITUDES_MAX_PENDIENTES=200

# Redis para la cola de correos masivos (BullMQ). Opcional: sin esto el envío masivo corre en segundo plano en el mismo proceso.
# REDIS_URL=redis://default:clave@host:6379
