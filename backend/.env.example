# Copia este archivo como .env y llena los valores. El .env nunca se sube al repositorio.

# development | test | production
NODE_ENV=development
PORT=4000

# Cadena de conexión de Postgres. En Supabase: Project Settings → Database → Connection string.
# Para la app con varias instancias, usa el Transaction pooler (puerto 6543).
# Para migraciones e importaciones, usa el Session pooler (5432) o la conexión directa.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/js_logistics
# true en Supabase (exige TLS); false en un Postgres local
DATABASE_SSL=false

# Secreto para firmar los JWT: mínimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración de la sesión (formato de jsonwebtoken: 8h, 12h, 7d…)
JWT_EXPIRA=12h

# Orígenes del frontend que pueden llamar a la API con cookies, separados por coma
CORS_ORIGENES=http://localhost:5173

# Nombre de la cookie que lleva el JWT
COOKIE_NOMBRE=jsl_sesion
# Dominio de la cookie (vacío = el del backend). Con subdominios propios: .midominio.com
COOKIE_DOMINIO=
# lax (recomendado: frontend y API en el mismo sitio) | strict | none (dominios distintos; Safari en iOS la puede bloquear)
COOKIE_SAMESITE=lax

# (Opcional) Certificado PEM de la base para verificar TLS. Pega el contenido en una línea con \n.
DATABASE_CA=

# Pool de conexiones. En Supabase session mode (puerto 5432) el límite es 15 por proyecto:
# con varios procesos (local + Render) usa 5. En transaction mode (puerto 6543) puedes subir a 10-20.
DATABASE_POOL_MAX=5
# Cerrar conexiones inactivas pronto libera cupo del pooler.
DATABASE_POOL_IDLE_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Supabase Storage (fotos y firmas). Project Settings → API. La service role key es SECRETA: solo en el backend.
# Crea el bucket como PRIVADO; el frontend recibe URL firmadas que vencen en 1 hora.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=pedidos

# Correo transaccional con Resend (https://resend.com). Crea la API key en Dashboard → API Keys.
# Sin RESEND_API_KEY la API funciona, pero no envía correos: en desarrollo el enlace sale en la consola.
# El dominio de CORREO_REMITENTE debe estar verificado en Resend (Domains).
# Para desarrollo sin dominio verificado: CORREO_REMITENTE=onboarding@resend.dev
# (Resend solo permite enviar desde ahí al correo de la cuenta con la que te registraste).
RESEND_API_KEY=
CORREO_REMITENTE=no-responder@jslogistics.pro
CORREO_NOMBRE=JS Logistics
# Logo que se muestra en el correo: URL absoluta y pública. Usa PNG (Outlook no muestra WebP).
CORREO_LOGO_URL=https://app.jslogistics.pro/logo.png
# A dónde responder si alguien contesta el correo (opcional).
CORREO_RESPUESTA=

# Enlaces de los correos: cada portal tiene sus pantallas /activar y /restablecer.
# En producción: https://jslogistics.pro y https://app.jslogistics.pro
URL_CLIENTES=http://localhost:3000
URL_EQUIPO=http://localhost:5173
# Vigencia: 60 minutos para cambiar la contraseña y 7 días para activar una cuenta.
ENLACE_CLAVE_MINUTOS=60
ENLACE_ACTIVACION_DIAS=7

# Proxies delante del backend (para la IP real en el límite de intentos).
# 1 = solo Render. 2 = frontend en Vercel que reescribe /api/* hacia Render.
TRUST_PROXY=1
