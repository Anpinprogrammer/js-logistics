# Variables del frontend (app de oficina y mensajeros). Copia este archivo a .env para desarrollo.
# Todo lo que empieza por VITE_ termina en el navegador: nunca pongas secretos aquí.

# URL del backend, sin /api al final (se agrega solo). En Vercel es obligatoria: producción https://api.jslogistics.pro.
# Debe ser un subdominio del mismo dominio de la app (app.X y api.X) para que la cookie funcione en Safari de iPhone.
# Vacía: la app llama a /api en su mismo dominio (solo sirve en desarrollo, con el proxy de Vite).
VITE_API_URL=

# "true" para usar datos inventados, sin backend.
VITE_DEMO=

# Solo en desarrollo: a dónde manda Vite las llamadas a /api cuando VITE_API_URL está vacía.
VITE_API_PROXY=http://localhost:4000
